APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEHcontrol custom variables (añadidas desde .env)
# Agregar solo las claves aquí; configurar los valores en despliegue o en el gestor de secretos.
SANCTUM_STATEFUL_DOMAINS= # Dominios stateful para Sanctum (ej: sehcontrol.example.com)
CACHE_DRIVER= # Driver de caché usado por Laravel (file, redis, database)
SEH_BRAND_NAME= # Nombre de la marca mostrada en la UI
SEH_API_BASE= # URL base de la API (ej: https://sehcontrol.example.com/api)
SEH_DOMAIN= # Dominio principal de la app (ej: sehcontrol.example.com)
SEH_RENDEZVOUS_PORT= # Puerto para rendezvous (ej: 21116)
SEH_RELAY= # Host/relay (ej: sehcontrol.example.com)
SEH_HEARTBEAT_SECONDS= # Intervalo en segundos para heartbeats (ej: 300)
SEH_POLL_SECONDS= # Intervalo en segundos para polling (ej: 1)
SEH_KEY= # Clave para cliente nativo (NO subir valores reales)
SEH_UNLOCK_PIN= # PIN cifrado para desbloqueo (opcional)
SEH_ADMIN_KEY= # Clave de administrador (proteger)
SEH_AGENT_SECRET= # Secreto del agente (proteger)
RUSTDESK_MIN_CLIENT_VERSION= # Versión mínima cliente RustDesk (opcional)
SEHCONTROL_KEY= # Clave para integración nativa (opcional)
